#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    int opcao;
    char nome[100], codigo[30], localizacao[100];
    char linha[300];
    FILE *arquivo;

    do {
        printf("\n=== CADASTRO DE EQUIPAMENTOS ===\n");
        printf("1 - Cadastrar equipamento\n");
        printf("2 - Listar equipamentos\n");
        printf("3 - Sair\n");
        printf("Escolha uma opcao: ");

        if (fgets(linha, sizeof(linha), stdin) == NULL)
            break;

        char *fim;
        long valor = strtol(linha, &fim, 10);

        if (fim == linha || (*fim != '\n' && *fim != '\0')
            || valor < 1 || valor > 3) {
            printf("Opcao invalida!\n");
            continue;
        }

        opcao = valor;

        if (opcao == 1) {
            printf("Nome do equipamento: ");
            fgets(nome, sizeof(nome), stdin);

            printf("Codigo de identificacao: ");
            fgets(codigo, sizeof(codigo), stdin);

            printf("Localizacao: ");
            fgets(localizacao, sizeof(localizacao), stdin);

            nome[strcspn(nome, "\n")] = '\0';
            codigo[strcspn(codigo, "\n")] = '\0';
            localizacao[strcspn(localizacao, "\n")] = '\0';

            arquivo = fopen("equipamentos.txt", "a");

            if (arquivo == NULL) {
                printf("Erro ao abrir o arquivo!\n");
                continue;
            }

            fprintf(arquivo, "Nome: %s | Codigo: %s | Localizacao: %s\n",
                    nome, codigo, localizacao);

            fclose(arquivo);
            printf("Equipamento cadastrado com sucesso!\n");
        }

        else if (opcao == 2) {
            arquivo = fopen("equipamentos.txt", "r");

            if (arquivo == NULL) {
                printf("Nenhum cadastro encontrado.\n");
                continue;
            }

            printf("\n=== EQUIPAMENTOS CADASTRADOS ===\n");

            while (fgets(linha, sizeof(linha), arquivo) != NULL)
                printf("%s", linha);

            fclose(arquivo);
        }

        else {
            printf("Programa encerrado!\n");
        }

    } while (opcao != 3);

    return 0;
}
